  cursor: pointer;
  box-shadow:
    0 4px 22px rgba(246,179,27,.36),
    0 2px  8px rgba(246,179,27,.22);
  transition: background .2s, box-shadow .2s, transform .15s;
  margin-bottom: 20px;
}
.ls-submit-btn:hover {
  background: #e6a810;
  box-shadow:
    0 8px 30px rgba(246,179,27,.46),
    0 3px 12px rgba(246,179,27,.26);
  transform: translateY(-1px);
}
.ls-submit-btn:active { transform: translateY(0); }
.ls-submit-btn svg {
  width: 18px; height: 18px;
  stroke: #0B0B0B; stroke-width: 2.3; fill: none;
  stroke-linecap: round; stroke-linejoin: round;
}

/* ── Security note ── */
.ls-security-note {
  display: flex;
  align-items: center;
  gap: 7px;
  justify-content: center;
}
.ls-security-note svg {
  width: 13px; height: 13px;
  stroke: #B0B0B0; stroke-width: 1.9; fill: none;
  stroke-linecap: round; stroke-linejoin: round;
  flex-shrink: 0;
}
.ls-security-note span {
  font-size: 11.5px;
  color: #B0B0B0;
}

/* ── Error banner ── */
.ls-error-msg {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(217,68,68,.08);
  border: 1px solid rgba(217,68,68,.25);
  border-radius: 10px;
  padding: 10px 14px;
  margin-bottom: 16px;
  font-size: 13px;
  color: #C53030;
}
.ls-error-msg svg {
  width: 15px; height: 15px;
  stroke: #C53030; stroke-width: 2; fill: none;
  flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════
   RESPONSIVE
   ═══════════════════════════════════════════════════ */
@media (max-width: 820px) {
  .ls-shell {
    flex-direction: column;
    height: auto;
    min-height: 100vh;
    border-radius: 0;
    width: 100%;
  }
  .ls-left { width: 100%; min-height: 260px; }
  .ls-form-wrap { padding: 32px 24px; max-width: 100%; }
}
</file>

<file path="css/style-premium.css">
/* BeeStation Premium UI/UX 2026 */

:root {
  --color-brand: #E3A83B;
  --color-brand-dark: #B97712;
  --color-brand-light: color-mix(in srgb, var(--color-brand) 14%, transparent);
  --color-brand-glow: color-mix(in srgb, var(--color-brand) 24%, transparent);

  --color-ink: #111111;
  --color-ink-soft: #1B1B1B;
  --color-ink-muted: #262626;

  --color-bg: #F7F2E8;
  --color-bg-soft: #F0E8DB;
  --color-bg-muted: #E4D7C4;

  --color-surface: #FFFCF8;
  --color-surface-raised: #FFFFFF;

  --color-border: color-mix(in srgb, var(--color-ink) 8%, transparent);
  --color-border-soft: color-mix(in srgb, var(--color-ink) 4%, transparent);

  --color-text: #16120C;
  --color-text-secondary: #605548;
  --color-text-tertiary: #8E8274;
  --color-text-inverse: #FFFFFF;

  --color-success: #11835C;
  --color-success-bg: color-mix(in srgb, var(--color-success) 10%, transparent);
  --color-warning: #C97C12;
  --color-warning-bg: color-mix(in srgb, var(--color-warning) 10%, transparent);
  --color-critical: #D94444;
  --color-critical-bg: color-mix(in srgb, var(--color-critical) 10%, transparent);
  --color-info: #2E63D3;
  --color-info-bg: color-mix(in srgb, var(--color-info) 10%, transparent);

  --color-chart-grid: color-mix(in srgb, var(--color-ink) 6%, transparent);
  --chart-brand-area-strong: color-mix(in srgb, var(--color-brand) 28%, transparent);
  --chart-brand-area-medium: color-mix(in srgb, var(--color-brand) 18%, transparent);
  --chart-brand-area-soft: transparent;

  --shadow-xs: 0 1px 2px color-mix(in srgb, var(--color-ink) 5%, transparent);
  --shadow-sm: 0 4px 12px color-mix(in srgb, var(--color-ink) 6%, transparent);
  --shadow-md: 0 16px 32px color-mix(in srgb, var(--color-ink) 8%, transparent);
  --shadow-lg: 0 24px 48px color-mix(in srgb, var(--color-ink) 10%, transparent);
  --shadow-xl: 0 34px 70px color-mix(in srgb, var(--color-ink) 14%, transparent);
  --shadow-glow: 0 0 0 3px color-mix(in srgb, var(--color-brand) 18%, transparent);
  --shadow-card-hover: 0 24px 48px color-mix(in srgb, var(--color-ink) 10%, transparent);
  --color-ripple: color-mix(in srgb, var(--color-brand) 18%, transparent);
  --color-brand-contrast: #111111;

  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-card: 24px;
  --radius-control: 16px;
  --radius-xl: 32px;
  --radius-badge: 999px;

  --space-1: 4px;
  --space-2: 8px;
  --space-3: 16px;
  --space-4: 24px;
  --space-5: 32px;
  --space-6: 48px;
  --space-7: 64px;

  --font-display: 'Sora', sans-serif;
  --font-body: 'Inter', sans-serif;
  --font-mono: 'IBM Plex Mono', monospace;

  --t-fast: 0.16s cubic-bezier(0.4, 0, 0.2, 1);
  --t-base: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  --t-slow: 0.45s cubic-bezier(0.16, 1, 0.3, 1);

  --sidebar-width: 292px;
  --topbar-height: 78px;

  --color-sidebar: #0B0B0B;
  --color-sidebar-line: color-mix(in srgb, #FFFFFF 8%, transparent);
  --color-sidebar-text: #F4F1EA;
  --color-sidebar-muted: #B6ADA2;
  --color-sidebar-faint: #7F766C;
  --color-sidebar-hover: color-mix(in srgb, #FFFFFF 6%, transparent);
  --color-logout: #FF6D6D;
  --color-logout-bg: color-mix(in srgb, var(--color-logout) 12%, transparent);

  --surface-glass: color-mix(in srgb, var(--color-surface) 82%, transparent);
  --surface-glass-border: color-mix(in srgb, var(--color-ink) 6%, transparent);
  --focus-ring: color-mix(in srgb, var(--color-brand) 24%, transparent);
}

html.dark {
  --color-ink: #EDE7DD;
  --color-ink-soft: #D7D0C2;
  --color-ink-muted: #B9B2A5;

  --color-bg: #070707;
  --color-bg-soft: #111111;
  --color-bg-muted: #1B1B1B;

  --color-surface: #0D0D0D;
  --color-surface-raised: #141414;

  --color-border: color-mix(in srgb, #FFFFFF 10%, transparent);
  --color-border-soft: color-mix(in srgb, #FFFFFF 5%, transparent);

  --color-text: #F2EDE3;
  --color-text-secondary: #B7AEA3;
  --color-text-tertiary: #827A70;
  --color-text-inverse: #0B0B0B;

  --color-brand-light: color-mix(in srgb, var(--color-brand) 12%, transparent);
  --color-success-bg: color-mix(in srgb, var(--color-success) 16%, transparent);
  --color-warning-bg: color-mix(in srgb, var(--color-warning) 16%, transparent);
  --color-critical-bg: color-mix(in srgb, var(--color-critical) 16%, transparent);
  --color-info-bg: color-mix(in srgb, var(--color-info) 16%, transparent);
  --color-chart-grid: color-mix(in srgb, #FFFFFF 5%, transparent);

  --shadow-xs: 0 1px 2px color-mix(in srgb, #000000 42%, transparent);
  --shadow-sm: 0 6px 18px color-mix(in srgb, #000000 52%, transparent);
  --shadow-md: 0 18px 36px color-mix(in srgb, #000000 62%, transparent);
  --shadow-lg: 0 26px 52px color-mix(in srgb, #000000 70%, transparent);
  --shadow-xl: 0 36px 72px color-mix(in srgb, #000000 76%, transparent);
  --shadow-card-hover: 0 28px 56px color-mix(in srgb, #000000 66%, transparent);

  --color-sidebar: #070707;
  --surface-glass: color-mix(in srgb, var(--color-surface) 88%, transparent);
  --surface-glass-border: color-mix(in srgb, #FFFFFF 6%, transparent);
  --color-ripple: color-mix(in srgb, var(--color-brand) 24%, transparent);
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: var(--font-body);
  color: var(--color-text);
  background:
    radial-gradient(circle at 10% 14%, color-mix(in srgb, var(--color-brand) 14%, transparent), transparent 26%),
    radial-gradient(circle at 85% 0%, color-mix(in srgb, var(--color-surface-raised) 60%, transparent), transparent 22%),
    linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-soft) 100%);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  transition: background-color var(--t-slow), color var(--t-slow);
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -2;
  background-image:
    radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--color-border-soft) 90%, transparent) 1px, transparent 0),
    linear-gradient(color-mix(in srgb, var(--color-border-soft) 100%, transparent) 1px, transparent 1px),
    linear-gradient(90deg, color-mix(in srgb, var(--color-border-soft) 100%, transparent) 1px, transparent 1px);
  background-size: 64px 64px, 28px 28px, 28px 28px;
  opacity: 0.38;
  mask-image: radial-gradient(circle at center, black, transparent 82%);
  -webkit-mask-image: radial-gradient(circle at center, black, transparent 82%);
}

body::after {
  content: '';
  position: fixed;
  inset: -12vmax;
  pointer-events: none;
  z-index: -3;
  background:
    radial-gradient(circle at 18% 18%, color-mix(in srgb, var(--color-brand) 18%, transparent), transparent 24%),
    radial-gradient(circle at 86% 12%, color-mix(in srgb, var(--color-surface-raised) 60%, transparent), transparent 22%),
    radial-gradient(circle at 78% 84%, color-mix(in srgb, var(--color-ink) 6%, transparent), transparent 25%);
  filter: blur(18px);
  animation: aurora-drift 18s ease-in-out infinite alternate;
}

h1, h2, h3, h4, h5, h6 {
  margin: 0;
  font-family: var(--font-display);
  letter-spacing: -0.03em;
  color: var(--color-text);
}

a { color: var(--color-brand); text-decoration: none; transition: color var(--t-fast), opacity var(--t-fast); }
a:hover { color: var(--color-brand-dark); }
button { font: inherit; border: 0; background: none; color: inherit; }
img { max-width: 100%; display: block; }

code {
  font-family: var(--font-mono);
  font-size: 0.86em;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
  background: var(--color-bg-muted);
}

:focus-visible {
  outline: 2px solid var(--color-brand);
  outline-offset: 2px;
}

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 999px; }
::-webkit-scrollbar-thumb:hover { background: var(--color-text-tertiary); }

.is-hidden { display: none !important; }
.u-muted { color: var(--color-text-secondary) !important; }
.u-muted-strong { color: var(--color-text-tertiary) !important; }
.u-mb-1 { margin-bottom: var(--space-1) !important; }
.u-mb-2 { margin-bottom: var(--space-2) !important; }
.u-mb-3 { margin-bottom: var(--space-3) !important; }
.u-mb-4 { margin-bottom: var(--space-4) !important; }
.u-mt-1 { margin-top: var(--space-1) !important; }
.u-mt-2 { margin-top: var(--space-2) !important; }
.u-py-2 { padding-top: var(--space-2) !important; padding-bottom: var(--space-2) !important; }
.u-icon-md svg, svg.u-icon-md { width: 16px !important; height: 16px !important; stroke-width: 1.6px; }
.u-icon-lg svg, svg.u-icon-lg { width: 28px !important; height: 28px !important; stroke-width: 1.5px; }
.stack { display: flex; flex-direction: column; gap: var(--space-4); }
.stack-fill { flex: 1; }

.text-secondary { color: var(--color-text-secondary); }
.text-tertiary { color: var(--color-text-tertiary); }
.text-mono { font-family: var(--font-mono); }
.text-sm { font-size: 0.875rem; }
.text-xs { font-size: 0.75rem; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-critical { color: var(--color-critical); }
.text-brand { color: var(--color-brand); }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); filter: blur(3px); }
  to { opacity: 1; transform: translateY(0); filter: blur(0); }
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes pulse-dot {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success) 58%, transparent); }
  70% { transform: scale(1); box-shadow: 0 0 0 8px transparent; }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 transparent; }
}
@keyframes shimmer {
  0% { background-position: -1200px 0; }
  100% { background-position: 1200px 0; }
}
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes floaty {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}
@keyframes soft-pulse {
  0%, 100% { transform: scale(1); opacity: 0.75; }
  50% { transform: scale(1.04); opacity: 1; }
}
@keyframes aurora-drift {
  0% { transform: translate3d(-1.5%, -1%, 0) scale(1); }
  100% { transform: translate3d(1.5%, 1%, 0) scale(1.03); }
}
@keyframes ripple {
  to { transform: scale(3.2); opacity: 0; }
}
@keyframes radar-ping {
  0% { transform: scale(1); opacity: 0.8; }
  100% { transform: scale(2.4); opacity: 0; }
}
@keyframes radar-ping-subtle {
  0% { transform: scale(1); opacity: 0.5; }
  100% { transform: scale(1.6); opacity: 0; }
}
@keyframes shake {
  10%, 90% { transform: translate3d(-1px, 0, 0); }
  20%, 80% { transform: translate3d(2px, 0, 0); }
  30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
  40%, 60% { transform: translate3d(4px, 0, 0); }
}

.animate-fadeUp { animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
.animate-fadeIn { animation: fadeIn 0.4s ease both; }
.stagger-1 { animation-delay: 0.05s; }
.stagger-2 { animation-delay: 0.1s; }
.stagger-3 { animation-delay: 0.15s; }
.stagger-4 { animation-delay: 0.2s; }
.stagger-5 { animation-delay: 0.25s; }
.stagger-6 { animation-delay: 0.3s; }

.app-container {
  display: flex;
  min-height: 100vh;
  position: relative;
}

.main-content {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sidebar {
  width: var(--sidebar-width);
  flex-shrink: 0;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow: hidden;
  z-index: 100;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, rgba(10, 10, 10, 0.98) 0%, rgba(7, 7, 7, 0.96) 100%);
  border-right: 1px solid var(--color-sidebar-line);
  box-shadow: 16px 0 50px color-mix(in srgb, #000000 12%, transparent);
}
.sidebar::before,
.sidebar::after {
  content: '';
  position: absolute;
  pointer-events: none;
}
.sidebar::before {
  inset: -80px -100px auto auto;
  width: 260px;
  height: 260px;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--color-brand) 20%, transparent), transparent 64%);
  filter: blur(8px);
}
.sidebar::after {
  inset: auto auto -60px -80px;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--color-text-inverse) 6%, transparent), transparent 70%);
}

.sidebar-header {
  padding: 26px 20px 18px;
  flex-shrink: 0;
}
.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 14px;
}
.sidebar-logo-frame {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: rgba(255, 255, 255, 0.04);
  flex-shrink: 0;
}
.sidebar-logo { width: 30px; height: 30px; object-fit: contain; }
.sidebar-brand-copy { display: flex; flex-direction: column; min-width: 0; }
.sidebar-kicker {
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-sidebar-faint);
}
.sidebar-title {
  font-family: var(--font-display);
  color: var(--color-sidebar-text);
  font-size: 1.12rem;
  font-weight: 700;
}

.sidebar-system-pill,
.sidebar-summary {
  margin: 0 16px 14px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--color-sidebar-line);
  backdrop-filter: blur(12px);
}
.sidebar-system-pill {
  padding: 10px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--color-sidebar-muted);
  font-size: 0.75rem;
  font-weight: 600;
}
.sidebar-system-pill span:last-child {
  font-family: var(--font-mono);
  color: color-mix(in srgb, var(--color-brand) 88%, var(--color-text-inverse));
}
.sidebar-summary {
  padding: 16px 14px;
  color: var(--color-sidebar-text);
}
.sidebar-summary-label {
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--color-sidebar-faint);
  margin-bottom: 8px;
}
.sidebar-summary-name {
  font-family: var(--font-display);
  font-size: 1rem;
  line-height: 1.25;
  margin-bottom: 10px;
}
.sidebar-summary-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.sidebar-status-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
  color: var(--color-sidebar-text);
  font-size: 0.72rem;
  font-weight: 600;
}
.sidebar-status-chip .status-dot { width: 7px; height: 7px; }
.sidebar-summary-time {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  color: var(--color-sidebar-muted);
}

.sidebar-nav {
  flex: 1;
  overflow-y: auto;
  padding: 4px 12px 10px;
}
.nav-group { margin-bottom: 18px; }
.nav-group-title {
  padding: 0 12px;
  margin-bottom: 10px;
  font-size: 0.64rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-sidebar-faint);
}
.nav-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 14px;
  margin: 2px 0;
  border-radius: 16px;
  color: var(--color-sidebar-muted);
  font-size: 0.9rem;
  font-weight: 500;
  transition: transform var(--t-fast), background var(--t-fast), color var(--t-fast), box-shadow var(--t-fast);
}
.nav-item::before {
  content: '';
  position: absolute;
  inset: 8px 8px 8px auto;
  width: 3px;
  border-radius: 999px;
  background: transparent;
}
.nav-item:hover {
  transform: translateX(2px);
  color: var(--color-sidebar-text);
  background: var(--color-sidebar-hover);
}
.nav-item.active {
  color: var(--color-text-inverse);
  background: linear-gradient(90deg, color-mix(in srgb, var(--color-brand) 18%, transparent), rgba(255, 255, 255, 0.05));
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-brand) 16%, transparent);
}
.nav-item.active::before {
  background: linear-gradient(180deg, var(--color-brand), var(--color-brand-dark));
}
.nav-item svg { width: 20px; height: 20px; stroke-width: 1.65px; flex-shrink: 0; }

.sidebar-footer {
  padding: 16px;
  border-top: 1px solid var(--color-sidebar-line);
  background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.02) 100%);
}
.sidebar-user {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px;
  border-radius: 18px;
  border: 1px solid var(--color-sidebar-line);
  background: rgba(255, 255, 255, 0.04);
  transition: transform var(--t-fast), border-color var(--t-fast), background var(--t-fast);
}
.sidebar-user:hover {
  transform: translateY(-1px);
  border-color: color-mix(in srgb, var(--color-text-inverse) 12%, transparent);
  background: rgba(255, 255, 255, 0.06);
}
.avatar {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  font-weight: 700;
  color: var(--color-ink);
  background: linear-gradient(135deg, var(--color-brand) 0%, color-mix(in srgb, var(--color-brand) 55%, var(--color-text-inverse)) 100%);
  box-shadow: 0 12px 20px color-mix(in srgb, var(--color-brand) 22%, transparent);
}
.user-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.user-name {
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--color-sidebar-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.user-email, .user-role {
  font-size: 0.72rem;
  color: var(--color-sidebar-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.logout-btn {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 999px;
  color: var(--color-sidebar-muted);
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
  transition: transform var(--t-fast), background var(--t-fast), border-color var(--t-fast), color var(--t-fast);
}
.logout-btn:hover {
  transform: translateY(-1px);
  color: var(--color-logout);
  background: var(--color-logout-bg);
  border-color: color-mix(in srgb, var(--color-logout) 20%, transparent);
}
