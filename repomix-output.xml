  background-size: 24px 24px;
  mask-image: radial-gradient(circle at center, black, transparent 82%);
  -webkit-mask-image: radial-gradient(circle at center, black, transparent 82%);
}
.auth-form-panel::after {
  content: '';
  position: absolute;
  top: 12%;
  right: 8%;
  width: 260px;
  height: 260px;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--color-brand) 12%, transparent), transparent 66%);
  filter: blur(10px);
  animation: soft-pulse 5.5s ease-in-out infinite;
}
.auth-card.login-card {
  width: min(100%, 520px);
  padding: 34px;
  border-radius: 28px;
  background: linear-gradient(180deg, color-mix(in srgb, var(--color-surface-raised) 90%, transparent), color-mix(in srgb, var(--color-surface) 96%, transparent));
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-xl);
  position: relative;
  overflow: hidden;
  animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.auth-card.login-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, color-mix(in srgb, var(--color-brand) 6%, transparent), transparent 28%, transparent 72%, color-mix(in srgb, var(--color-brand) 3%, transparent));
  pointer-events: none;
}
.auth-card.login-card > * { position: relative; z-index: 1; }
.login-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
}
.login-head-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: var(--color-brand-light);
  color: var(--color-brand-dark);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.login-head-badge svg { width: 14px; height: 14px; }
.login-lock-visual {
  width: 62px;
  height: 62px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 20px;
  background: radial-gradient(circle at 32% 32%, color-mix(in srgb, var(--color-surface-raised) 92%, transparent), color-mix(in srgb, var(--color-brand) 16%, transparent) 42%, color-mix(in srgb, var(--color-ink) 90%, transparent));
  color: var(--color-text-inverse);
  box-shadow: var(--shadow-md);
}
.login-lock-visual svg { width: 22px; height: 22px; }
.login-hero-copy { margin-bottom: 20px; }
.login-hero-copy h2 {
  margin-bottom: 10px;
  font-size: clamp(2rem, 2.8vw, 2.8rem);
}
.login-meta-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 22px;
}
.login-meta-card {
  padding: 14px;
  font-size: clamp(2.1rem, 3vw, 3.1rem);
  border: 1px solid var(--color-border);
.login-hero-copy .auth-copy span { color: var(--color-brand); font-weight: 600; }
.login-footnote {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 18px;
  color: var(--color-text-tertiary);
  font-size: 0.82rem;
}
.login-footnote svg { width: 15px; height: 15px; }
  background: linear-gradient(180deg, color-mix(in srgb, var(--color-surface-raised) 92%, transparent), color-mix(in srgb, var(--color-surface) 98%, transparent));
.login-footer-note {
  margin-top: 20px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--color-text-tertiary);
  font-size: 0.82rem;
}
.login-footer-note svg { width: 15px; height: 15px; flex-shrink: 0; }
  position: relative;
  overflow: hidden;
}
.connect-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card, 24px);
  border: 1px solid var(--color-border);
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--color-surface-raised) 92%, transparent) 0%, var(--color-surface) 100%);
  box-shadow: var(--shadow-md);
  padding: 40px;
  margin: auto;
  width: 100%;
  max-width: 480px;
}
.connect-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, color-mix(in srgb, var(--color-brand) 5%, transparent), transparent 35%, transparent 68%, color-mix(in srgb, var(--color-brand) 3%, transparent));
  pointer-events: none;
}
.connect-card > * { position: relative; z-index: 1; }
.connect-icon {
  width: 84px;
  height: 84px;
  display: grid;
  place-items: center;
  margin: 0 auto 16px;
  border-radius: 28px;
  color: var(--color-text-inverse);
  box-shadow: var(--shadow-md);
  position: relative;
  isolation: isolate;
}
.connect-icon::before,
.connect-icon::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  z-index: -1;
  pointer-events: none;
}
.connect-icon.offline::before {
  border: 2px solid var(--color-critical);
  animation: radar-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
}
.connect-icon.offline::after {
  border: 2px solid var(--color-critical);
  animation: radar-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite 1s;
}
.connect-icon.online::before {
  border: 2px solid var(--color-success);
  animation: radar-ping-subtle 3s ease-out infinite;
}
@media (prefers-reduced-motion: reduce) {
  .connect-icon.offline::before,
  .connect-icon.offline::after,
  .connect-icon.online::before {
    animation: none;
    display: none;
  }
}
.connect-icon.online { background: linear-gradient(135deg, var(--color-success), color-mix(in srgb, var(--color-success) 50%, var(--color-text-inverse))); }
.connect-icon.offline { background: linear-gradient(135deg, var(--color-critical), color-mix(in srgb, var(--color-critical) 50%, var(--color-text-inverse))); }
.connect-icon svg { width: 28px; height: 28px; }
.connect-card h1 {
  margin-bottom: 10px;
  font-size: clamp(2rem, 3vw, 3rem);
}
.connect-copy {
  margin: 0 auto 22px;
  max-width: 42rem;
  color: var(--color-text-secondary);
  line-height: 1.7;
}
.action-buttons {
  display: grid;
  gap: 12px;
  margin-top: 12px;
  width: 100%;
}
.form-reset { margin: 0; }
.btn-full { width: 100%; }
.warning-alert {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 18px 0 6px;
  padding: 14px 16px;
  border-radius: 16px;
  border: 1px solid color-mix(in srgb, var(--color-warning) 18%, transparent);
  background: var(--color-warning-bg);
  color: var(--color-warning);
  text-align: left;
}
.warning-alert svg { width: 18px; height: 18px; margin-top: 2px; flex-shrink: 0; }
.connect-footer {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid var(--color-border-soft);
  color: var(--color-text-tertiary);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.frequency-card { min-height: 190px; }
.frequency-zone-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}
.zone-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}
.zone-dot.success { background: var(--color-success); }
.zone-dot.critical { background: var(--color-critical); }
.zone-dot.brand { background: var(--color-brand); }
.zone-dot.is-pulsing { animation: pulse-dot 1.8s infinite; }
.zone-range {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-secondary);
}
.zone-range.critical { color: var(--color-critical); }
.zone-title {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 10px;
}
.zone-title.success { color: var(--color-success); }
.zone-title.critical { color: var(--color-critical); }
.zone-title.brand { color: var(--color-brand-dark); }
.zone-normal { border-top: 3px solid var(--color-success); }
.zone-alert { border-top: 3px solid var(--color-critical); }
.zone-alert-active { border-top: 3px solid var(--color-critical); box-shadow: var(--shadow-md); }
.zone-queen { border-top: 3px solid var(--color-brand); }

.alert-banner {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 700;
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  box-shadow: var(--shadow-xs);
}
.alert-banner.critical {
  color: var(--color-critical);
  background: var(--color-critical-bg);
  border-color: color-mix(in srgb, var(--color-critical) 18%, transparent);
}
.alert-banner .status-dot { animation: pulse-dot 1.8s infinite; }

@media (max-width: 1280px) {
  .page-content { padding: 26px 26px 38px; }
  .dashboard-hero, .page-hero { grid-template-columns: 1fr; }
  .hero-panel { min-height: 180px; }
  .auth-shell, .connect-shell { flex-direction: column; }
  .auth-brand-panel, .auth-form-panel { flex: none; width: 100%; }
  .auth-brand-panel { padding: 40px 28px; }
  .auth-form-panel { padding: 40px 28px 48px; }
}

@media (max-width: 1100px) {
  .sidebar { width: 280px; }
  .grid-4-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid-3-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dashboard-insights-grid { grid-template-columns: 1fr; }
  .topbar-search { display: none; }
}

@media (max-width: 860px) {
  .app-container { display: block; }
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    transform: translateX(-102%);
    transition: transform var(--t-base);
    box-shadow: var(--shadow-xl);
  }
  .sidebar.open { transform: translateX(0); }
  .main-content { min-height: 100vh; }
  .mobile-menu-btn { display: inline-grid; }
  .topbar {
    padding: 0 18px;
    gap: 12px;
    height: auto;
    min-height: 72px;
    flex-wrap: wrap;
    align-items: center;
  }
  .topbar-left { width: 100%; }
  .topbar-right { margin-left: auto; }
  .page-content { padding: 22px 18px 34px; }
  .page-header { flex-direction: column; align-items: flex-start; }
  .grid-4-cols, .grid-3-cols, .grid-2x2, .metric-compact-grid, .page-hero-grid, .feature-cards-row, .info-grid { grid-template-columns: 1fr; }
  .dashboard-hero, .page-hero { gap: 18px; }
  .brand-top-row { align-items: flex-start; }
  .feature-cards-row { margin-top: 12px; }
  .form-options { flex-direction: column; align-items: flex-start; }
}

@media (max-width: 560px) {
  .page-content { padding: 18px 14px 28px; }
  .card, .dashboard-hero, .page-hero, .auth-card.login-card, .connect-card { border-radius: 22px; }
  .card, .dashboard-hero, .page-hero, .auth-card.login-card, .connect-card { border-radius: 22px; }
  .dashboard-hero, .page-hero, .auth-card.login-card, .connect-card { padding: 20px; }
  .sidebar-header { padding: 22px 16px 14px; }
  .sidebar-system-pill, .sidebar-summary, .sidebar-footer { margin-left: 12px; margin-right: 12px; }
  .topbar { padding: 0 14px; }
  .topbar-left { gap: 10px; }
  .topbar-title-row { flex-wrap: wrap; }
  .hero-chip-row { flex-direction: column; }
  .btn-floating { right: 16px; bottom: 16px; width: 48px; height: 48px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; scroll-behavior: auto !important; }
}
