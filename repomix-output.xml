<file path="css/style.css">
/* ═══════════════════════════════════════════════════════════════
   BeeStation — Premium SaaS Design System v3.0
   ═══════════════════════════════════════════════════════════════ */

/* ─── 1. TOKENS / VARIABLES ─────────────────────────────────────── */
:root {
  /* Core Colors */
  --color-brand:           #E9A93F;
  --color-brand-dark:      #C97C12;
  --color-brand-light:     rgba(233, 169, 63, 0.14);
  --color-brand-glow:      rgba(233, 169, 63, 0.24);
  
  /* Monochrome & Neutrals */
  --color-ink:             #0A0A0A;
  --color-ink-soft:        #171717;
  --color-ink-muted:       #262626;
  
  /* Backgrounds */
  --color-bg:              #F7F3EA;
  --color-bg-soft:         #F2ECE1;
  --color-bg-muted:        #E6DDCE;
  
  /* Surfaces */
  --color-surface:         #FFFCF7;
  --color-surface-raised:  #FFFFFF;
  
  /* Borders */
  --color-border:          rgba(32, 25, 14, 0.08);
  --color-border-soft:     rgba(32, 25, 14, 0.045);
  
  /* Typography */
  --color-text:            #15120C;
  --color-text-secondary:  #5C5347;
  --color-text-tertiary:   #8E8577;
  --color-text-inverse:    #FFFFFF;
  
  /* Status Colors */
  --color-success:         #059669;
  --color-success-bg:      rgba(5, 150, 105, 0.1);
  --color-warning:         #D97706;
  --color-warning-bg:      rgba(217, 119, 6, 0.1);
  --color-critical:        #DC2626;
  --color-critical-bg:     rgba(220, 38, 38, 0.1);
  --color-info:            #2563EB;
  --color-info-bg:         rgba(37, 99, 235, 0.1);
  
  /* Chart Colors */
  --color-chart-grid:        rgba(32, 25, 14, 0.06);
  --chart-brand-area-strong: rgba(233, 169, 63, 0.22);
  --chart-brand-area-medium: rgba(233, 169, 63, 0.34);
  --chart-brand-area-soft:   rgba(233, 169, 63, 0);
  
  /* Elevation & Shadows (Vercel/Linear style) */
  --shadow-xs:   0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-sm:   0 2px 4px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.03);
  --shadow-md:   0 4px 12px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.03);
  --shadow-lg:   0 12px 24px rgba(0, 0, 0, 0.06), 0 4px 8px rgba(0, 0, 0, 0.04);
  --shadow-xl:   0 24px 48px rgba(0, 0, 0, 0.08);
  --shadow-glow: 0 0 0 3px var(--color-brand-glow);
  --shadow-card-hover: 0 12px 24px rgba(0, 0, 0, 0.06), 0 4px 8px rgba(0, 0, 0, 0.04);
  --color-ripple: rgba(233, 169, 63, 0.18);
  --color-brand-contrast: #111111;
  
  /* Radii */
  --radius-sm:     6px;
  --radius-md:     8px;
  --radius-card:   16px;
  --radius-control:8px;
  --radius-xl:     24px;
  --radius-badge:  999px;
  
  /* Spacing */
  --space-1:  4px;
  --space-2:  8px;
  --space-3:  16px;
  --space-4:  24px;
  --space-5:  32px;
  --space-6:  48px;
  --space-7:  64px;
  
  /* Fonts */
  --font-display: 'Sora', sans-serif;
  --font-body:    'Inter', sans-serif;
  --font-mono:    'IBM Plex Mono', monospace;
  
  /* Transitions */
  --t-fast:   0.15s cubic-bezier(0.4, 0, 0.2, 1);
  --t-base:   0.25s cubic-bezier(0.4, 0, 0.2, 1);
  --t-slow:   0.4s cubic-bezier(0.4, 0, 0.2, 1);
  
  /* Layout Dimensions */
  --sidebar-width: 260px;
  --topbar-height: 64px;
  
  /* Sidebar Specifics (Dark minimal by default) */
  --color-sidebar: #0A0A0A;
  --color-sidebar-line: rgba(255, 255, 255, 0.08);
  --color-sidebar-text: #EDEDED;
  --color-sidebar-muted: #A3A3A3;
  --color-sidebar-faint: #737373;
  --color-sidebar-hover: rgba(255, 255, 255, 0.06);
  --color-logout: #EF4444;
  --color-logout-bg: rgba(239, 68, 68, 0.1);
  
  /* Glassmorphism */
  --surface-glass: rgba(255, 255, 255, 0.85);
  --surface-glass-border: rgba(0, 0, 0, 0.05);
  --focus-ring: rgba(245, 166, 35, 0.2);
}

/* ─── DARK MODE ──────────────────────────────────────────────────── */
html.dark {
  --color-ink:             #EDEDED;
  --color-ink-soft:        #D4D4D4;
  --color-ink-muted:       #A3A3A3;
  
  --color-bg:              #050505;
  --color-bg-soft:         #0A0A0A;
  --color-bg-muted:        #171717;
  
  --color-surface:         #0A0A0A;
  --color-surface-raised:  #121212;
  
  --color-border:          rgba(255, 255, 255, 0.08);
  --color-border-soft:     rgba(255, 255, 255, 0.04);
  
  --color-text:            #EDEDED;
  --color-text-secondary:  #A3A3A3;
  --color-text-tertiary:   #737373;
  --color-text-inverse:    #0A0A0A;
  
  --color-brand-light:     rgba(233, 169, 63, 0.1);
  --color-success-bg:      rgba(5, 150, 105, 0.15);
  --color-warning-bg:      rgba(217, 119, 6, 0.15);
  --color-critical-bg:     rgba(220, 38, 38, 0.15);
  --color-info-bg:         rgba(37, 99, 235, 0.15);
  
  --color-chart-grid:      rgba(255, 255, 255, 0.05);
  
  --shadow-sm:             0 2px 4px rgba(0, 0, 0, 0.5);
  --shadow-md:             0 4px 12px rgba(0, 0, 0, 0.6);
  --shadow-lg:             0 12px 24px rgba(0, 0, 0, 0.7);
  --shadow-card-hover:     0 12px 24px rgba(0, 0, 0, 0.7);
  
  --color-sidebar: #050505;
  
  --surface-glass: rgba(10, 10, 10, 0.85);
  --surface-glass-border: rgba(255, 255, 255, 0.05);
  --color-ripple: rgba(233, 169, 63, 0.24);
}

/* ─── 2. RESET & BASE ───────────────────────────────────────────── */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  font-family: var(--font-body);
  color: var(--color-text);
  background-color: var(--color-bg);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  transition: background-color var(--t-slow), color var(--t-slow);
  overflow-x: hidden;
}

/* Background grid for texture */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image: 
    linear-gradient(var(--color-border-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-border-soft) 1px, transparent 1px);
  background-size: 32px 32px;
  mask-image: radial-gradient(circle at center, black, transparent 80%);
  -webkit-mask-image: radial-gradient(circle at center, black, transparent 80%);
  opacity: 0.5;
}

body::after {
  content: '';
  position: fixed;
  inset: -10vmax;
  z-index: -2;
  pointer-events: none;
  background:
    radial-gradient(circle at 15% 20%, rgba(233, 169, 63, 0.18), transparent 24%),
    radial-gradient(circle at 82% 12%, rgba(255, 255, 255, 0.42), transparent 20%),
    radial-gradient(circle at 90% 85%, rgba(20, 18, 12, 0.05), transparent 22%);
  filter: blur(16px);
  animation: aurora-drift 18s ease-in-out infinite alternate;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.02em;
}

a { color: var(--color-brand); text-decoration: none; transition: color var(--t-fast); }
a:hover { color: var(--color-brand-dark); }
button { font-family: inherit; cursor: pointer; border: none; outline: none; background: none; }

code {
  font-family: var(--font-mono);
  font-size: 0.85em;
  background: var(--color-bg-muted);
  padding: 2px 6px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
}

:focus-visible {
  outline: 2px solid var(--color-brand);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 99px; }
::-webkit-scrollbar-thumb:hover { background: var(--color-text-tertiary); }

/* Shared utilities */
.is-hidden { display: none !important; }
.u-muted { color: var(--color-text-secondary) !important; }
.u-muted-strong { color: var(--color-text-tertiary) !important; }
.u-mb-1 { margin-bottom: var(--space-1) !important; }
.u-mb-2 { margin-bottom: var(--space-2) !important; }
.u-mb-3 { margin-bottom: var(--space-3) !important; }
.u-mb-4 { margin-bottom: var(--space-4) !important; }
.u-mt-1 { margin-top: var(--space-1) !important; }
.u-mt-2 { margin-top: var(--space-2) !important; }
.u-py-2 { padding-top: var(--space-2) !important; padding-bottom: var(--space-2) !important; }
.u-icon-md svg, svg.u-icon-md { width: 16px !important; height: 16px !important; stroke-width: 1.5px; }
.u-icon-lg svg, svg.u-icon-lg { width: 28px !important; height: 28px !important; stroke-width: 1.5px; }
.metric-empty { color: var(--color-text-tertiary) !important; }
.stack { display: flex; flex-direction: column; gap: var(--space-4); }
.stack-fill { flex: 1; }

.text-secondary    { color: var(--color-text-secondary); }
.text-tertiary     { color: var(--color-text-tertiary); }
.text-mono         { font-family: var(--font-mono); }
.text-sm           { font-size: 0.875rem; }
.text-xs           { font-size: 0.75rem; }
.font-medium       { font-weight: 500; }
.font-semibold     { font-weight: 600; }
.font-bold         { font-weight: 700; }
.text-success      { color: var(--color-success); }
.text-warning      { color: var(--color-warning); }
.text-critical     { color: var(--color-critical); }
.text-brand        { color: var(--color-brand); }

/* ─── 4. ANIMATIONS ─────────────────────────────────────────────── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); filter: blur(4px); }
  to   { opacity: 1; transform: translateY(0); filter: blur(0); }
}
@keyframes fadeIn  { from { opacity: 0; filter: blur(2px); } to { opacity: 1; filter: blur(0); } }
@keyframes pulse-dot {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(5, 150, 105, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
}
@keyframes shimmer {
  0%   { background-position: -1000px 0; }
  100% { background-position: 1000px 0; }
}
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes floaty {
  0%, 100% { transform: translateY(0px) translateX(0px); }
  50% { transform: translateY(-10px) translateX(4px); }
}
@keyframes soft-pulse {
  0%, 100% { transform: scale(1); opacity: 0.82; }
  50% { transform: scale(1.04); opacity: 1; }
}
@keyframes aurora-drift {
  0% { transform: translate3d(-1.5%, -1%, 0) scale(1); }
  100% { transform: translate3d(1.5%, 1%, 0) scale(1.03); }
}

.animate-fadeUp { animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
.animate-fadeIn { animation: fadeIn 0.4s ease both; }
.stagger-1 { animation-delay: 0.05s; }
.stagger-2 { animation-delay: 0.1s; }
.stagger-3 { animation-delay: 0.15s; }
.stagger-4 { animation-delay: 0.2s; }
.stagger-5 { animation-delay: 0.25s; }
.stagger-6 { animation-delay: 0.3s; }

/* ─── 5. LAYOUT ─────────────────────────────────────────────────── */
.app-container {
  display: flex;
  min-height: 100vh;
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  transition: background-color var(--t-slow);
}

/* ─── 6. SIDEBAR ────────────────────────────────────────────────── */
.sidebar {
  width: var(--sidebar-width);
  background-color: var(--color-sidebar);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  transition: transform var(--t-base);
  position: relative;
  z-index: 100;
  border-right: 1px solid var(--color-sidebar-line);
}

.sidebar-header {
  padding: 24px 20px;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.sidebar-logo-frame {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  flex-shrink: 0;
}

.sidebar-logo {
  width: 30px;
  height: 30px;
  object-fit: contain;
}

.sidebar-brand-copy {
  display: flex;
  flex-direction: column;
}

.sidebar-kicker {
  font-size: 0.65rem;
  text-transform: uppercase;
  color: var(--color-sidebar-faint);
  letter-spacing: 0.15em;
  font-weight: 700;
}

.sidebar-title {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-sidebar-text);
  letter-spacing: -0.02em;
}

.sidebar-system-pill {
  margin: 0 20px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  border-radius: var(--radius-md);
  background: var(--color-sidebar-hover);
  border: 1px solid var(--color-sidebar-line);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-sidebar-muted);
}
.sidebar-system-pill span:last-child {
  color: var(--color-brand);
  font-family: var(--font-mono);
  letter-spacing: 0.05em;
}

.sidebar-nav {
  flex: 1;
  overflow-y: auto;
  padding: 0 12px;
}

.nav-group { margin-bottom: 24px; }

.nav-group-title {
  font-size: 0.7rem;
  color: var(--color-sidebar-faint);
  padding: 0 12px;
  margin-bottom: 8px;
  font-weight: 600;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 12px;
  margin: 2px 0;
  color: var(--color-sidebar-muted);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: all var(--t-fast);
  font-weight: 500;
  font-size: 0.875rem;
  position: relative;
}

.nav-item:hover {
  background-color: var(--color-sidebar-hover);
  color: var(--color-sidebar-text);
}

.nav-item.active {
  background-color: rgba(255, 255, 255, 0.08);
  color: #FFFFFF;
}

.nav-item.active::before {
  content: '';
  position: absolute;
  left: 0px; top: 50%;
  transform: translateY(-50%);
  height: 16px;
  width: 3px;
  background: var(--color-brand);
  border-radius: 0 4px 4px 0;
}

.nav-item svg { width: 18px; height: 18px; stroke-width: 1.5px; flex-shrink: 0; }

.sidebar-footer {
  padding: 16px;
  border-top: 1px solid var(--color-sidebar-line);
}

.sidebar-user {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px;
  border-radius: var(--radius-md);
  background: var(--color-sidebar-hover);
  border: 1px solid var(--color-sidebar-line);
  transition: border-color var(--t-fast);
}
.sidebar-user:hover {
  border-color: rgba(255, 255, 255, 0.15);
}

.avatar {
  width: 36px; height: 36px;
  border-radius: var(--radius-sm);
  background: var(--color-sidebar-line);
  color: var(--color-sidebar-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.9rem;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--color-sidebar-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-email, .user-role {
  font-size: 0.7rem;
  color: var(--color-sidebar-faint);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px; height: 32px;
  border-radius: var(--radius-sm);
  color: var(--color-sidebar-faint);
  transition: all var(--t-fast);
  flex-shrink: 0;
}

.logout-btn:hover {
  background: var(--color-logout-bg);
  color: var(--color-logout);
}
.logout-btn svg { width: 16px; height: 16px; }

/* ─── 8. TOPBAR ─────────────────────────────────────────────────── */
.topbar {
  background-color: var(--surface-glass);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--surface-glass-border);
  padding: 0 var(--space-4);
  height: var(--topbar-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 50;
}

.topbar-left { display: flex; align-items: center; gap: var(--space-3); }

.topbar-greeting {
  display: flex;
  flex-direction: column;
}
.topbar-eyebrow {
  font-size: 0.75rem;
  color: var(--color-text-secondary);
  font-weight: 600;
}
.topbar-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.topbar-section {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1rem;
}
.hive-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  background: var(--color-bg-muted);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-text-secondary);
}
.hive-chip svg { width: 14px; height: 14px; color: var(--color-brand); }

.topbar-search {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: var(--color-bg-soft);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  min-width: 300px;
  transition: all var(--t-fast);
}
.topbar-search:focus-within {
  border-color: var(--color-brand);
  background: var(--color-surface);
  box-shadow: 0 0 0 3px var(--focus-ring);
}
.topbar-search svg { width: 16px; height: 16px; color: var(--color-text-tertiary); }
.topbar-search input {
  border: none;
  background: transparent;
  width: 100%;
  font-family: var(--font-body);
  font-size: 0.875rem;
  color: var(--color-text);
  outline: none;
}
.topbar-search input::placeholder { color: var(--color-text-tertiary); }

.topbar-right { display: flex; align-items: center; gap: var(--space-2); }

.esp-status-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  border-radius: var(--radius-badge);
  font-size: 0.75rem;
  font-weight: 600;
  border: 1px solid var(--color-border);
  background: var(--color-surface);
}

.status-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background-color: var(--color-success);
}
.esp-status-pill.online .status-dot {
  animation: pulse-dot 2s infinite;
}
.esp-status-pill.offline .status-dot {
  background-color: var(--color-critical);
}
.esp-status-pill.warning .status-dot {
  background-color: var(--color-warning);
  animation: pulse-dot-warning 2s infinite;
}
.status-dot.warning { background-color: var(--color-warning); }
.esp-label { color: var(--color-text-secondary); }

@keyframes pulse-dot-warning {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 var(--color-warning); }
  50% { opacity: 0.6; box-shadow: 0 0 0 6px transparent; }
}

.topbar-divider { width: 1px; height: 24px; background: var(--color-border); margin: 0 8px; }

.clock {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.topbar-btn, .notifications-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px; height: 36px;
  border-radius: var(--radius-md);
  color: var(--color-text-secondary);
  background: transparent;
  border: 1px solid transparent;
  transition: all var(--t-fast);
  cursor: pointer;
  position: relative;
}
.topbar-btn:hover, .notifications-btn:hover {
  background: var(--color-bg-soft);
  color: var(--color-text);
  border-color: var(--color-border);
}
.topbar-btn svg, .notifications-btn svg { width: 18px; height: 18px; stroke-width: 1.5px; }

.notification-badge {
  position: absolute;
  top: 6px; right: 6px;
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--color-brand);
  border: 2px solid var(--color-surface);
}

.mobile-menu-btn { display: none; }

/* ─── 9. PAGE CONTENT ───────────────────────────────────────────── */
.page-content {
  padding: var(--space-5) var(--space-6);
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--space-5);
}

.page-title { 
  font-size: 1.75rem; 
  font-weight: 700; 
  letter-spacing: -0.03em;
  color: var(--color-text);
  margin-bottom: 4px;
}
.page-subtitle { color: var(--color-text-secondary); font-size: 0.875rem; }

/* ─── 10. CARDS ─────────────────────────────────────────────────── */
.card {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  padding: var(--space-4);
  box-shadow: var(--shadow-sm);
  transition: all var(--t-base);
  position: relative;
  overflow: hidden;
}

.card:hover {
  box-shadow: var(--shadow-md);
  border-color: var(--color-border-soft);
  transform: translateY(-2px);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
}

.card-title { 
  font-size: 1rem; 
  font-weight: 600; 
  color: var(--color-text); 
  display: flex;
  align-items: center;
  gap: 8px;
}
.card-title .badge { margin-left: 8px; }
.card-header-compact { margin-bottom: var(--space-2); }
.alert-title-row { display: flex; align-items: center; }

/* ─── 11. METRIC CARDS ──────────────────────────────────────────── */
.metric-card {
  display: flex;
  flex-direction: column;
  padding: var(--space-4);
}

.metric-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: var(--color-border);
}
.metric-card.success::before { background: var(--color-success); }
.metric-card.warning::before { background: var(--color-warning); }
.metric-card.critical::before{ background: var(--color-critical); }
.metric-card.brand::before   { background: var(--color-brand); }

.metric-icon {
  width: 40px; height: 40px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-3);
  border: 1px solid var(--color-border);
}
.metric-icon svg { width: 20px; height: 20px; }
.metric-icon.brand    { background: var(--color-brand-light); color: var(--color-brand-dark); border-color: transparent; }
.metric-icon.success  { background: var(--color-success-bg);  color: var(--color-success); border-color: transparent; }
.metric-icon.warning  { background: var(--color-warning-bg);  color: var(--color-warning); border-color: transparent; }
.metric-icon.critical { background: var(--color-critical-bg); color: var(--color-critical); border-color: transparent; }
.metric-icon.neutral  { background: var(--color-bg-muted); color: var(--color-text-secondary); border-color: transparent; }

.metric-header {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--color-text-secondary);
  margin-bottom: 8px;
  font-size: 0.8125rem;
  font-weight: 600;
}
.metric-header svg { width: 14px; height: 14px; }

.metric-value {
  font-family: var(--font-mono);
  font-size: 2.5rem;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.04em;
  display: flex;
  align-items: baseline;
  gap: 6px;
  line-height: 1;
  margin-bottom: var(--space-3);
}

.metric-unit {
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--color-text-tertiary);
  font-weight: 500;
  letter-spacing: 0;
}

.metric-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  border-top: 1px solid var(--color-border-soft);
  padding-top: var(--space-3);
}

/* ─── 13. BADGES ─────────────────────────────────────────────────── */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  font-weight: 600;
  font-size: 0.75rem;
  line-height: 1;
  white-space: nowrap;
}

.badge-success  { background: var(--color-success-bg);  color: var(--color-success); }
.badge-warning  { background: var(--color-warning-bg);  color: var(--color-warning); }
.badge-critical { background: var(--color-critical-bg); color: var(--color-critical); }
.badge-brand    { background: var(--color-brand-light); color: var(--color-brand-dark); }
.badge-neutral  { background: var(--color-bg-muted);    color: var(--color-text-secondary); }

/* ─── 14. GRIDS ──────────────────────────────────────────────────── */
.grid-2x2   { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); margin-bottom: var(--space-4); }
.grid-4-cols{ display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); margin-bottom: var(--space-4); }
.grid-3-cols{ display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-bottom: var(--space-4); }
.dashboard-insights-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: var(--space-4);
}

/* ─── 15. BUTTONS ────────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  font-weight: 500;
  font-size: 0.875rem;
  transition: all var(--t-fast);
  cursor: pointer;
  border: 1px solid transparent;
  white-space: nowrap;
}

.btn svg { width: 16px; height: 16px; stroke-width: 2px; }

.btn-primary { 
  background: var(--color-ink); 
  color: var(--color-text-inverse); 
  border-color: var(--color-ink);
  box-shadow: var(--shadow-sm);
}
.btn-primary:hover { 
  background: var(--color-ink-soft); 
  transform: translateY(-1px); 
  box-shadow: var(--shadow-md); 
}

.btn-brand { 
  background: var(--color-brand); 
  color: #000; 
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}
.btn-brand:hover { 
  background: var(--color-brand-dark); 
  transform: translateY(-1px); 
  box-shadow: 0 4px 12px var(--color-brand-glow); 
  color: #FFF;
}

.btn-secondary { 
  background: var(--color-surface); 
  border-color: var(--color-border); 
  color: var(--color-text); 
  box-shadow: var(--shadow-xs);
}
.btn-secondary:hover { 
  background: var(--color-bg-soft); 
  border-color: var(--color-border); 
}

.btn-ghost { background: transparent; color: var(--color-text-secondary); }
.btn-ghost:hover { background: var(--color-bg-soft); color: var(--color-text); }

.btn-sm { padding: 6px 12px; font-size: 0.8125rem; }

.btn-floating {
  position: fixed;
  bottom: var(--space-4); right: var(--space-4);
  width: 48px; height: 48px;
  border-radius: 50%;
  background: var(--color-ink);
  color: var(--color-text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: 1000;
  transition: all var(--t-base);
}
.btn-floating:hover { 
  transform: translateY(-2px) scale(1.05); 
  box-shadow: var(--shadow-xl); 
}

/* ─── 16. FORMS ──────────────────────────────────────────────────── */
.form-group { margin-bottom: var(--space-4); }

.form-label { 
  display: block; 
  font-size: 0.875rem; 
  font-weight: 500; 
  margin-bottom: 8px; 
  color: var(--color-text); 
}

.form-control {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--color-text);
  background: var(--color-surface);
  transition: all var(--t-fast);
  box-shadow: var(--shadow-xs);
}
.form-control:focus { 
  border-color: var(--color-brand); 
  outline: none; 
  box-shadow: 0 0 0 3px var(--focus-ring); 
}

/* ─── 17. TABLES ─────────────────────────────────────────────────── */
.table-container { 
  overflow-x: auto; 
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

table { width: 100%; border-collapse: collapse; text-align: left; }

th {
  padding: 12px var(--space-4);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: var(--color-bg-soft);
  border-bottom: 1px solid var(--color-border);
}

td {
  padding: 16px var(--space-4);
  font-size: 0.875rem;
  border-bottom: 1px solid var(--color-border-soft);
  color: var(--color-text);
}

tbody tr:last-child td { border-bottom: none; }
tbody tr { transition: background var(--t-fast); }
tbody tr:hover td { background: var(--color-bg-soft); }

.sensor-type-cell { display: flex; align-items: center; gap: 12px; font-weight: 500;}
.sensor-icon-wrap {
  width: 32px; height: 32px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
  border: 1px solid var(--color-border);
}

/* ─── MISC / ALERTS / LOGS ───────────────────────────────────────── */
.chart-shell-sm { height: 280px; width: 100%; }
.chart-note { font-size: 0.8rem; color: var(--color-text-tertiary); margin-top: 4px; }

.alert-list { list-style: none; }
.alert-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--color-border-soft);
}
.alert-item:last-child { border-bottom: none; padding-bottom: 0; }
.alert-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 6px; }
.alert-dot.bg-critical { background: var(--color-critical); }
.alert-dot.bg-warning { background: var(--color-warning); }
.alert-dot.brand-dot { background: var(--color-brand); }
.alert-content { flex: 1; }
.alert-title { font-weight: 600; font-size: 0.875rem; margin-bottom: 4px; }
.alert-desc { font-size: 0.8125rem; color: var(--color-text-secondary); }
.alert-time { font-size: 0.75rem; color: var(--color-text-tertiary); }
.alert-zero { display: flex; align-items: center; gap: 8px; padding: 12px 0; color: var(--color-text-secondary); }

.ibb-gauge { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-3); }
.ibb-bar { flex: 1; height: 8px; background: var(--color-bg-muted); border-radius: 99px; overflow: hidden; }
.ibb-fill { 
  height: 100%; 
  border-radius: 99px; 
  background: linear-gradient(90deg, var(--color-critical), var(--color-warning), var(--color-success)); 
  transition: width 1s ease-out;
}
.ibb-value { font-family: var(--font-mono); font-size: 1.5rem; font-weight: 700; min-width: 48px; text-align: right; }
.ibb-note { font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 8px; }

.empty-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; padding: var(--space-7) var(--space-4);
}
.empty-icon-circle {
  width: 64px; height: 64px; border-radius: 50%; background: var(--color-bg-soft); border: 1px solid var(--color-border);
  display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-3); color: var(--color-text-secondary);
}
.empty-title { font-size: 1.125rem; font-weight: 600; margin-bottom: var(--space-1); }
.empty-desc { color: var(--color-text-secondary); font-size: 0.875rem; max-width: 420px; line-height: 1.6; }
.empty-state.compact { padding: var(--space-5) var(--space-3); }

/* STAT PILLS */
.stat-pill {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-surface);
  border: 1px solid var(--color-border); box-shadow: var(--shadow-sm);
}
.stat-pill-value { font-family: var(--font-mono); font-size: 2rem; font-weight: 700; line-height: 1; margin-bottom: 8px; }
.stat-pill-label { font-size: 0.75rem; color: var(--color-text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

/* INFO GRID */
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
.info-grid-item .label { font-size: 0.75rem; color: var(--color-text-tertiary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; font-weight: 600; }
.info-grid-item .value { font-family: var(--font-mono); font-weight: 500; font-size: 0.95rem; }

/* DEVICE STATUS */
.device-status-card { margin-bottom: var(--space-4); }
.device-status-row { display: flex; align-items: center; gap: 12px; margin-bottom: var(--space-3); }
.device-status-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--color-success); }
.device-status-dot.offline { background: var(--color-critical); }
.device-status-label { font-size: 1.125rem; font-weight: 700; }
.endpoint-box { background: var(--color-bg-soft); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 12px 16px; font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: var(--space-3); overflow-x: auto; }

/* ─── AUTH / LOGIN ───────────────────────────────────────────────── */
.auth-body {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 18%, rgba(233, 169, 63, 0.16), transparent 28%),
    radial-gradient(circle at 90% 10%, rgba(255, 255, 255, 0.58), transparent 26%),
    linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-soft) 100%);
}

.auth-shell {
  display: flex;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.auth-shell::before,
.auth-shell::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.auth-shell::before {
  width: 460px;
  height: 460px;
  right: -160px;
  top: -120px;
  background: radial-gradient(circle, rgba(233, 169, 63, 0.18), transparent 68%);
  filter: blur(10px);
}

.auth-shell::after {
  width: 320px;
  height: 320px;
  left: -110px;
  bottom: -140px;
  background: radial-gradient(circle, rgba(18, 15, 10, 0.08), transparent 70%);
  filter: blur(12px);
}

.auth-brand-panel {
  flex: 1.1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 56px;
  position: relative;
  overflow: hidden;
  isolation: isolate;
  background:
    radial-gradient(circle at 20% 18%, rgba(233, 169, 63, 0.18), transparent 22%),
    linear-gradient(135deg, #090909 0%, #131313 100%);
  color: #FFF;
}

.floating-hexagons {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
}
.float-hex {
    position: absolute;
    color: var(--color-brand, #F6B31B);
    opacity: 0.12;
    animation: floatHex 8s ease-in-out infinite;
}
.float-hex-1 { width: 48px; height: 48px; top: 15%; left: 10%; animation-delay: 0s; }
.float-hex-2 { width: 72px; height: 72px; top: 60%; left: 75%; animation-delay: 2.5s; }
.float-hex-3 { width: 36px; height: 36px; top: 80%; left: 20%; animation-delay: 5s; }

@keyframes floatHex {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-16px) rotate(8deg); }
}

.auth-brand-panel::before {
  content: '';
  position: absolute;
  inset: 22px;
  border-radius: 32px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02)),
    repeating-linear-gradient(30deg, transparent 0 28px, rgba(255, 255, 255, 0.03) 29px 30px, transparent 31px 58px);
  opacity: 0.9;
}

.auth-brand-panel::after {
  content: '';
  position: absolute;
  inset: auto;
  width: 340px;
  height: 340px;
  right: -70px;
  top: 40px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(233, 169, 63, 0.22), transparent 66%);
  animation: soft-pulse 5.2s ease-in-out infinite;
}

.brand-content {
  position: relative;
  z-index: 1;
  width: min(100%, 560px);
  animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.auth-banner {
  padding: 18px;
  border-radius: 22px;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.03)),
    radial-gradient(circle at top right, rgba(233, 169, 63, 0.22), transparent 28%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  margin-bottom: 22px;
  position: relative;
  overflow: hidden;
}

.auth-banner::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 0 35%, rgba(255, 255, 255, 0.09) 50%, transparent 65%);
  animation: shimmer 3.2s linear infinite;
  opacity: 0.32;
}

.auth-banner-label {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.72);
  margin-bottom: 10px;
}

.auth-banner-title {
  position: relative;
  z-index: 1;
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 2vw, 1.9rem);
  line-height: 1.16;
  color: #FFF;
  margin-bottom: 8px;
}

.auth-banner-copy {
  position: relative;
  z-index: 1;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.95rem;
  line-height: 1.6;
}

.login-hero-row {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-bottom: 20px;
}

.brand-logo {
  width: 64px;
  height: 64px;
  border-radius: 12px;
  margin-bottom: var(--space-4, 16px);
  object-fit: contain;
  box-shadow: 0 22px 40px rgba(0, 0, 0, 0.24);
  animation: floaty 7.5s ease-in-out infinite;
  flex-shrink: 0;
}

.brand-title {
  font-size: clamp(3rem, 5vw, 4.4rem);
  letter-spacing: -0.05em;
  margin-bottom: 6px;
  color: #FFF;
}

.brand-slogan {
  font-size: 1.04rem;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.65;
  max-width: 36rem;
}

.auth-hero-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-top: 24px;
}

.auth-hero-stat {
  padding: 14px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(10px);
}

.auth-hero-stat strong {
  display: block;
  font-family: var(--font-display);
  font-size: 1.25rem;
  color: #FFF;
  margin-bottom: 6px;
}

.auth-hero-stat span {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.68);
}

.auth-signal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 22px;
}

.auth-signal {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 14px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 0.875rem;
  font-weight: 500;
  transition: transform var(--t-fast), background var(--t-fast), border-color var(--t-fast);
}

.auth-signal:hover {
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(233, 169, 63, 0.18);
}

.auth-signal svg {
  width: 16px;
  height: 16px;
  color: var(--color-brand);
}

.hero-chip-row {
  margin-top: 18px;
}

.hero-chip {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.8);
}

.auth-form-panel {
  flex: 0.95;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 56px 48px;
  position: relative;
  background:
    radial-gradient(circle at top right, rgba(233, 169, 63, 0.08), transparent 28%),
    linear-gradient(180deg, var(--color-surface) 0%, rgba(255, 252, 247, 0.96) 100%);
}

.auth-form-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--color-border-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-border-soft) 1px, transparent 1px);
  background-size: 24px 24px;
  mask-image: radial-gradient(circle at center, black, transparent 84%);
  -webkit-mask-image: radial-gradient(circle at center, black, transparent 84%);
  opacity: 0.28;
}

.auth-form-panel::after {
  content: '';
  position: absolute;
  width: 260px;
  height: 260px;
  top: 14%;
  right: 10%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(233, 169, 63, 0.12), transparent 66%);
  filter: blur(12px);
  animation: soft-pulse 5.5s ease-in-out infinite;
}

.auth-card.login-card {
  width: min(100%, 500px);
  padding: 30px;
  border-radius: 30px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.84) 0%, rgba(255, 252, 247, 0.96) 100%),
    radial-gradient(circle at top right, rgba(233, 169, 63, 0.08), transparent 28%);
  border: 1px solid rgba(32, 25, 14, 0.08);
  box-shadow: 0 32px 70px rgba(18, 15, 10, 0.1);
  position: relative;
  overflow: hidden;
  animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
}

html.dark .auth-card.login-card {
  background:
    linear-gradient(180deg, rgba(12, 12, 12, 0.88) 0%, rgba(8, 8, 8, 0.98) 100%),
    radial-gradient(circle at top right, rgba(233, 169, 63, 0.08), transparent 28%);
  border-color: rgba(255, 255, 255, 0.08);
}

.auth-card.login-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(135deg, rgba(233, 169, 63, 0.06), transparent 28%, transparent 72%, rgba(233, 169, 63, 0.03));
  pointer-events: none;
}

.auth-card.login-card > * {
  position: relative;
  z-index: 1;
}

.login-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 12px;
}

.login-head-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: var(--color-brand-light);
  color: var(--color-brand-dark);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.login-head-badge svg {
  width: 14px;
  height: 14px;
}

.login-lock-visual {
  width: 62px;
  height: 62px;
  border-radius: 20px;
  background:
    radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.95), rgba(233, 169, 63, 0.18) 36%, rgba(0, 0, 0, 0.92) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 18px 34px rgba(18, 15, 10, 0.12);
  flex-shrink: 0;
}

.login-lock-visual svg {
  width: 22px;
  height: 22px;
}

.login-hero-copy {
  margin-bottom: 20px;
}

.login-hero-copy h2 {
  margin-bottom: 10px;
  font-size: clamp(2rem, 2.8vw, 2.8rem);
}

.login-hero-copy .auth-copy {
  margin-bottom: 0;
}

.login-meta-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 22px;
}

.login-meta-card {
  padding: 14px;
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.75), rgba(255, 252, 247, 0.92));
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-xs);
}

html.dark .login-meta-card {
  background: linear-gradient(180deg, rgba(18, 18, 18, 0.88), rgba(10, 10, 10, 0.94));
}

.login-meta-card strong {
  display: block;
  font-family: var(--font-display);
  font-size: 1.1rem;
  margin-bottom: 4px;
}

.login-meta-card span {
  font-size: 0.74rem;
  color: var(--color-text-secondary);
}

.floating-field { position: relative; }
.floating-field .form-control { padding-left: 46px; }

.floating-field::before,
.password-input-wrapper::before {
  content: '';
  position: absolute;
  left: 16px;
  top: 50%;
  width: 18px;
  height: 18px;
  border-radius: 6px;
  background: var(--color-brand-light);
  border: 1px solid rgba(233, 169, 63, 0.16);
  pointer-events: none;
  transform: translateY(-50%);
  z-index: 1;
}

.floating-field::after,
.password-input-wrapper::after {
  content: '';
  position: absolute;
  left: 22px;
  top: 50%;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-brand);
  pointer-events: none;
  transform: translateY(-50%);
  z-index: 1;
}

.password-input-wrapper { position: relative; }
.password-input-wrapper .form-control { padding-left: 46px; padding-right: 52px; }

.password-toggle {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--color-text-tertiary);
  background: transparent;
  cursor: pointer;
  padding: 4px;
  border-radius: 10px;
}

.password-toggle:hover {
  color: var(--color-text);
  background: var(--color-bg-soft);
}

.form-options {
  display: flex;
  justify-content: space-between;
  font-size: 0.875rem;
  margin-bottom: var(--space-5);
  align-items: center;
  gap: 12px;
}

.remember-me {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--color-text-secondary);
  cursor: pointer;
}

.remember-me input {
  accent-color: var(--color-brand);
  width: 16px;
  height: 16px;
  cursor: pointer;
}

.forgot-password { font-weight: 600; color: var(--color-text); }

.login-btn {
  width: 100%;
  min-height: 52px;
  padding: 14px 18px;
  font-size: 1rem;
  border-radius: 18px;
  box-shadow: 0 16px 32px rgba(233, 169, 63, 0.18);
  position: relative;
  overflow: hidden;
}

.login-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 0 32%, rgba(255, 255, 255, 0.26) 50%, transparent 68%);
  transform: translateX(-120%);
  transition: transform 0.85s ease;
}

.login-btn:hover::after {
  transform: translateX(120%);
}

.login-footer {
  margin-top: 26px;
  padding-top: 18px;
  border-top: 1px solid var(--color-border-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-size: 0.75rem;
  color: var(--color-text-tertiary);
}

.login-footer::before {
  content: 'BeeStation Access';
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-text-tertiary);
}

.login-footer::after {
  content: 'Premium interface';
  font-size: 0.75rem;
  color: var(--color-text-secondary);
}

.login-error {
  background: var(--color-critical-bg);
  color: var(--color-critical);
  padding: 12px 14px;
  border-radius: 16px;
  margin-bottom: var(--space-4);
  display: flex;
  gap: 8px;
  align-items: center;
  font-size: 0.875rem;
  border: 1px solid rgba(220, 38, 38, 0.14);
}

.shake-animation { animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both; }
@keyframes shake {
  10%, 90% { transform: translate3d(-1px, 0, 0); }
  20%, 80% { transform: translate3d(2px, 0, 0); }
  30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
  40%, 60% { transform: translate3d(4px, 0, 0); }
}

.btn-spinner { animation: spin 1s linear infinite; }

/* ─── 18. PREMIUM VISUAL SYSTEM ────────────────────────────────── */
body {
  background:
    radial-gradient(circle at top left, rgba(245, 166, 35, 0.12), transparent 28%),
    radial-gradient(circle at 85% 0%, rgba(255, 255, 255, 0.5), transparent 24%),
    linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-soft) 100%);
}

body::before {
  background-image:
    linear-gradient(var(--color-border-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-border-soft) 1px, transparent 1px),
    radial-gradient(circle at 1px 1px, var(--color-border-soft) 1px, transparent 0);
  background-size: 32px 32px, 32px 32px, 64px 64px;
  opacity: 0.35;
}

.app-container {
  position: relative;
  min-height: 100vh;
}

.sidebar {
  width: 292px;
  background:
    linear-gradient(180deg, rgba(8, 8, 8, 0.98) 0%, rgba(10, 10, 10, 0.94) 100%);
  border-right: 1px solid var(--color-sidebar-line);
  box-shadow: 12px 0 40px rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 0;
  height: 100vh;
  overflow: hidden;
}

.sidebar::before,
.sidebar::after {
  content: '';
  position: absolute;
  inset: auto;
  pointer-events: none;
}

.sidebar::before {
  width: 240px;
  height: 240px;
  top: -120px;
  right: -100px;
  background: radial-gradient(circle, rgba(245, 166, 35, 0.18), transparent 68%);
  filter: blur(10px);
}

.sidebar::after {
  width: 180px;
  height: 180px;
  bottom: -80px;
  left: -80px;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.06), transparent 70%);
}

.sidebar-header {
  padding: 26px 20px 20px;
}

.sidebar-brand {
  gap: 14px;
}

.sidebar-logo-frame {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  flex-shrink: 0;
}

.sidebar-logo {
  width: 30px;
  height: 30px;
  object-fit: contain;
}

.sidebar-kicker {
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  color: var(--color-sidebar-faint);
}

.sidebar-title {
  font-size: 1.15rem;
}

.sidebar-system-pill,
.sidebar-summary {
  margin: 0 16px 14px;
  border-radius: 18px;
  border: 1px solid var(--color-sidebar-line);
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(12px);
}

.sidebar-system-pill {
  padding: 10px 14px;
  letter-spacing: 0.01em;
}

.sidebar-system-pill span:last-child {
  color: #ffd166;
}

.sidebar-summary {
  padding: 16px 14px;
  color: var(--color-sidebar-text);
  position: relative;
}

.sidebar-summary-label {
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--color-sidebar-faint);
  margin-bottom: 6px;
}

.sidebar-summary-name {
  font-family: var(--font-display);
  font-size: 1rem;
  line-height: 1.2;
  margin-bottom: 10px;
}

.sidebar-summary-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.sidebar-status-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  font-weight: 600;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
  color: var(--color-sidebar-text);
}

.sidebar-status-chip .status-dot {
  width: 7px;
  height: 7px;
}

.sidebar-summary-time {
  font-size: 0.74rem;
  color: var(--color-sidebar-muted);
  font-family: var(--font-mono);
}

.sidebar-nav {
  padding: 4px 12px 10px;
}

.nav-group {
  margin-bottom: 18px;
}

.nav-group-title {
  font-size: 0.64rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 10px;
}

.nav-item {
  padding: 12px 14px;
  border-radius: 14px;
  color: var(--color-sidebar-muted);
  gap: 14px;
}

.nav-item::after {
  content: '';
  position: absolute;
  inset: 8px 8px 8px auto;
  width: 2px;
  border-radius: 99px;
  background: transparent;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.06);
  color: var(--color-sidebar-text);
  transform: translateX(2px);
}

.nav-item.active {
  background: linear-gradient(90deg, rgba(245, 166, 35, 0.18), rgba(255, 255, 255, 0.05));
  color: #fff;
  box-shadow: inset 0 0 0 1px rgba(245, 166, 35, 0.18);
}

.nav-item.active::before {
  width: 4px;
  height: 22px;
  left: 8px;
  border-radius: 99px;
  background: linear-gradient(180deg, var(--color-brand), var(--color-brand-dark));
}

.nav-item svg {
  width: 20px;
  height: 20px;
}

.sidebar-footer {
  padding: 16px;
  border-top: 1px solid var(--color-sidebar-line);
  background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.02) 100%);
}

.sidebar-user {
  padding: 12px;
  gap: 14px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.04);
}

.sidebar-user:hover {
  border-color: rgba(255, 255, 255, 0.12);
}

.avatar {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(245, 166, 35, 0.95), rgba(255, 209, 102, 0.88));
  color: #111;
  box-shadow: 0 10px 18px rgba(245, 166, 35, 0.2);
}

.user-name {
  color: var(--color-sidebar-text);
  font-size: 0.92rem;
}

.user-email,
.user-role {
  color: var(--color-sidebar-muted);
}

.logout-btn {
  width: 36px;
  height: 36px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.logout-btn:hover {
  background: rgba(239, 68, 68, 0.12);
  border-color: rgba(239, 68, 68, 0.16);
}

.topbar {
  height: 78px;
  padding: 0 28px;
  gap: 20px;
  background: rgba(250, 250, 250, 0.78);
  border-bottom: 1px solid var(--surface-glass-border);
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.7) inset;
}

html.dark .topbar {
  background: rgba(5, 5, 5, 0.8);
}

.topbar-left {
  gap: 16px;
}

.topbar-greeting {
  gap: 2px;
}

.topbar-eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 0.68rem;
}

.topbar-section {
  font-size: 1.05rem;
}

.topbar-search {
  min-width: 360px;
  padding: 10px 14px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: var(--shadow-xs);
}

html.dark .topbar-search {
  background: rgba(10, 10, 10, 0.72);
}

.topbar-search input {
  font-size: 0.92rem;
}

.topbar-right {
  gap: 10px;
}

.esp-status-pill {
  padding: 8px 14px;
  border-radius: 999px;
  background: linear-gradient(180deg, var(--color-surface), var(--color-bg-soft));
}

.esp-label {
  color: var(--color-text);
  font-weight: 600;
}

.clock {
  padding: 8px 12px;
  border-radius: 999px;
  background: var(--color-bg-soft);
  border: 1px solid var(--color-border);
  color: var(--color-text);
}

.topbar-btn,
.notifications-btn,
.mobile-menu-btn {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-xs);
}

.topbar-btn:hover,
.notifications-btn:hover,
.mobile-menu-btn:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
  border-color: rgba(245, 166, 35, 0.18);
}

.page-content {
  max-width: 1520px;
  padding: 28px 32px 40px;
}

.page-header {
  align-items: end;
  gap: 16px;
  margin-bottom: 24px;
}

.page-title {
  font-size: clamp(1.8rem, 2.4vw, 2.4rem);
  letter-spacing: -0.04em;
  margin-bottom: 6px;
}

.page-subtitle {
  font-size: 0.92rem;
  color: var(--color-text-secondary);
}

.card {
  border-radius: 24px;
  padding: 22px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.95) 100%);
  border: 1px solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 18px 42px rgba(15, 15, 15, 0.06);
  backdrop-filter: blur(16px);
}

html.dark .card {
  background: linear-gradient(180deg, rgba(16, 16, 16, 0.96) 0%, rgba(10, 10, 10, 0.98) 100%);
  border-color: rgba(255, 255, 255, 0.07);
}

.card::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(135deg, rgba(245, 166, 35, 0.04), transparent 26%, transparent 74%, rgba(245, 166, 35, 0.02));
}

.card:hover {
  transform: translateY(-3px);
  box-shadow: 0 26px 60px rgba(15, 15, 15, 0.08);
  border-color: rgba(245, 166, 35, 0.12);
}

.card-header {
  margin-bottom: 18px;
}

.card-title {
  font-size: 1.02rem;
  letter-spacing: -0.02em;
}

.metric-card {
  min-height: 190px;
  padding: 22px;
}

.metric-icon {
  width: 46px;
  height: 46px;
  border-radius: 16px;
}

.metric-header {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.7rem;
}

.metric-value {
  font-size: clamp(2rem, 4vw, 2.9rem);
}

.metric-footer {
  padding-top: 16px;
}

.badge {
  border-radius: 999px;
  padding: 6px 10px;
  border: 1px solid transparent;
}

.badge-success  { border-color: rgba(5, 150, 105, 0.18); }
.badge-warning  { border-color: rgba(217, 119, 6, 0.18); }
.badge-critical { border-color: rgba(220, 38, 38, 0.18); }
.badge-brand    { border-color: rgba(245, 166, 35, 0.18); }
.badge-neutral  { border-color: var(--color-border); }

.dashboard-hero {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 24px;
  align-items: stretch;
  margin-bottom: 24px;
  overflow: hidden;
}

.dashboard-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at top right, rgba(245, 166, 35, 0.14), transparent 32%),
    radial-gradient(circle at bottom left, rgba(37, 99, 235, 0.08), transparent 26%);
  pointer-events: none;
}

.hero-copy {
  position: relative;
  z-index: 1;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.7rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  background: var(--color-brand-light);
  color: var(--color-brand-dark);
  margin-bottom: 14px;
}

.dashboard-hero h2 {
  font-size: clamp(2rem, 3vw, 3rem);
  line-height: 1.04;
  letter-spacing: -0.05em;
  margin-bottom: 12px;
}

.hero-copy p,
.dashboard-hero .page-subtitle {
  max-width: 62ch;
  font-size: 0.98rem;
}

.hero-chip-row,
.hero-status-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.hero-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.65);
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: 0.86rem;
  box-shadow: var(--shadow-xs);
}

html.dark .hero-chip {
  background: rgba(10, 10, 10, 0.68);
}

.hero-chip svg {
  width: 16px;
  height: 16px;
}

.hero-panel {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220px;
}

.hero-ring {
  width: 190px;
  height: 190px;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.92), rgba(245, 166, 35, 0.16) 42%, rgba(10, 10, 10, 0.88) 100%);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 24px 60px rgba(0, 0, 0, 0.1);
  position: relative;
}

.hero-ring::before,
.hero-ring::after {
  content: '';
  position: absolute;
  inset: 18px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.hero-ring::after {
  inset: 42px;
  border-color: rgba(245, 166, 35, 0.18);
}

.hero-kpi {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 6px;
}

.hero-kpi-value {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  color: var(--color-text-inverse);
}

.hero-kpi-label {
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.72);
}

.grid-4-cols,
.grid-3-cols,
.grid-2x2,
.dashboard-insights-grid {
  gap: 22px;
}

.page-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(300px, 0.85fr);
  gap: 22px;
  margin-bottom: 22px;
}

.page-hero-panel,
.page-hero-copy {
  position: relative;
  overflow: hidden;
}

.page-hero-copy {
  padding: 24px;
}

.page-hero-panel {
  min-height: 100%;
  display: flex;
  align-items: stretch;
}

.page-hero-copy h2,
.page-hero-copy .page-title {
  margin-bottom: 10px;
}

.page-hero-copy p {
  max-width: 68ch;
}

.page-hero-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 18px;
}

.page-kpi-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 16px;
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.75), rgba(255, 252, 247, 0.94));
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-xs);
}

html.dark .page-kpi-card {
  background: linear-gradient(180deg, rgba(18, 18, 18, 0.88), rgba(10, 10, 10, 0.94));
}

.page-kpi-card span {
  font-size: 0.74rem;
  color: var(--color-text-secondary);
}

.page-kpi-card strong {
  font-family: var(--font-display);
  font-size: 1.2rem;
  line-height: 1;
}

.page-hero-aside {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 24px;
}

.page-hero-aside .hero-chip {
  justify-content: space-between;
  width: 100%;
  padding: 12px 14px;
}

.panel-divider {
  height: 1px;
  background: var(--color-border-soft);
  margin: 4px 0;
}

.endpoint-box {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(255, 252, 247, 0.96));
  border: 1px solid var(--color-border);
  border-radius: 18px;
  padding: 14px 16px;
  font-family: var(--font-mono);
  font-size: 0.88rem;
  margin-bottom: var(--space-3);
  overflow-x: auto;
  box-shadow: var(--shadow-xs);
}

html.dark .endpoint-box {
  background: linear-gradient(180deg, rgba(18, 18, 18, 0.88), rgba(10, 10, 10, 0.94));
}

.premium-empty {
  padding: 28px;
  border-radius: 24px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 252, 247, 0.96));
  border: 1px solid var(--color-border);
  box-shadow: 0 18px 40px rgba(15, 15, 15, 0.06);
}

html.dark .premium-empty {
  background: linear-gradient(180deg, rgba(18, 18, 18, 0.9), rgba(10, 10, 10, 0.96));
}

.premium-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 18px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(233, 169, 63, 0.12), rgba(255, 255, 255, 0.65));
  border: 1px solid rgba(233, 169, 63, 0.16);
  box-shadow: var(--shadow-xs);
}

.premium-banner .badge {
  flex-shrink: 0;
}

.subtle-note {
  font-size: 0.8rem;
  color: var(--color-text-tertiary);
}

.chart-frame {
  padding: 18px;
  border-radius: 22px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(255, 252, 247, 0.96));
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-xs);
}

html.dark .chart-frame {
  background: linear-gradient(180deg, rgba(18, 18, 18, 0.88), rgba(10, 10, 10, 0.94));
}

.metric-compact-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.metric-mini {
  padding: 18px;
  border-radius: 20px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 252, 247, 0.96));
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-xs);
}

html.dark .metric-mini {
  background: linear-gradient(180deg, rgba(18, 18, 18, 0.88), rgba(10, 10, 10, 0.94));
}

.metric-mini .metric-value {
  font-size: 2.2rem;
  margin-bottom: 10px;
}

.metric-mini .metric-footer {
  padding-top: 12px;
}

.table-shell {
  padding: 0;
  overflow: hidden;
}

.table-shell .table-container {
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.dashboard-metrics {
  margin-bottom: 22px;
}

.chart-shell,
.chart-shell-sm {
  width: 100%;
}

.chart-shell { height: 340px; }
.chart-shell-sm { height: 300px; }

.chart-note {
  font-size: 0.78rem;
  color: var(--color-text-tertiary);
}

.alert-banner {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 600;
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  box-shadow: var(--shadow-xs);
}

.alert-banner.critical {
  border-color: rgba(220, 38, 38, 0.18);
  background: var(--color-critical-bg);
  color: var(--color-critical);
}

.frequency-card {
  min-height: 170px;
}

.frequency-zone-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.zone-dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
}

.zone-dot.success { background: var(--color-success); }
.zone-dot.critical { background: var(--color-critical); }
.zone-dot.brand { background: var(--color-brand); }

.zone-range {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--color-text-secondary);
}

.zone-title {
  font-family: var(--font-display);
  font-size: 1.2rem;
  margin-bottom: 8px;
}

.zone-title.success { color: var(--color-success); }
.zone-title.critical { color: var(--color-critical); }
.zone-title.brand { color: var(--color-brand-dark); }

.zone-alert-active {
  box-shadow: 0 18px 32px rgba(220, 38, 38, 0.08);
}

.info-grid {
  gap: 18px;
}

.info-grid-item .label {
  color: var(--color-text-tertiary);
}

.info-grid-item .value {
  font-size: 1rem;
}

.empty-state {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.98));
  border-style: dashed;
}

html.dark .empty-state {
  background: linear-gradient(180deg, rgba(16, 16, 16, 0.92), rgba(10, 10, 10, 0.96));
}

.btn {
  min-height: 42px;
  padding: 10px 16px;
  border-radius: 999px;
  position: relative;
  overflow: hidden;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn-brand {
  background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-dark) 100%);
  color: #111;
}

.btn-brand:hover {
  color: #111;
  box-shadow: 0 14px 28px rgba(245, 166, 35, 0.2);
}

.btn-secondary,
.btn-ghost {
  background: var(--color-surface);
}

.btn-floating {
  border-radius: 18px;
  width: 52px;
  height: 52px;
  background: linear-gradient(135deg, var(--color-ink) 0%, var(--color-ink-soft) 100%);
}

.form-control {
  min-height: 48px;
  border-radius: 16px;
  background: var(--color-surface);
  box-shadow: var(--shadow-xs);
}

.form-control:focus {
  transform: translateY(-1px);
}

.floating-field .form-label {
  margin-bottom: 8px;
  color: var(--color-text-secondary);
}

.password-input-wrapper .form-control {
  padding-right: 52px;
}

.table-container {
  border-radius: 20px;
  box-shadow: var(--shadow-xs);
}

table {
  overflow: hidden;
}

thead th {
  background: linear-gradient(180deg, var(--color-bg-soft), rgba(255, 255, 255, 0.72));
}

tbody tr:hover td {
  background: rgba(245, 166, 35, 0.04);
}

.auth-body {
  background:
    radial-gradient(circle at 12% 18%, rgba(245, 166, 35, 0.14), transparent 28%),
    radial-gradient(circle at 90% 10%, rgba(255, 255, 255, 0.45), transparent 26%),
    linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-soft) 100%);
}

.auth-shell {
  overflow: hidden;
}

.auth-brand-panel {
  background:
    radial-gradient(circle at 25% 20%, rgba(245, 166, 35, 0.18), transparent 24%),
    linear-gradient(135deg, #0a0a0a 0%, #121212 100%);
}

.auth-brand-panel::after {
  background-image:
    linear-gradient(120deg, transparent 0 44%, rgba(245, 166, 35, 0.08) 46%, transparent 48%),
    repeating-linear-gradient(30deg, transparent 0 28px, rgba(255, 255, 255, 0.03) 29px 30px, transparent 31px 58px);
  opacity: 0.9;
}

.brand-content {
  max-width: 520px;
}

.brand-logo {
  width: 64px;
  height: 64px;
  border-radius: 12px;
  margin-bottom: var(--space-4, 16px);
  object-fit: contain;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
}

.brand-title {
  font-size: clamp(3rem, 6vw, 4.4rem);
}

.brand-slogan {
  color: rgba(255, 255, 255, 0.7);
  max-width: 36rem;
}

.auth-signal-grid {
  gap: 14px;
}

.auth-signal {
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.08);
}

.auth-form-panel {
  background:
    radial-gradient(circle at top right, rgba(245, 166, 35, 0.08), transparent 28%),
    var(--color-surface);
}

.auth-card {
  max-width: 460px;
  border-radius: 28px;
  padding: 28px;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 28px 60px rgba(15, 15, 15, 0.09);
  backdrop-filter: blur(18px);
}

html.dark .auth-card {
  background: rgba(10, 10, 10, 0.84);
  border-color: rgba(255, 255, 255, 0.08);
}

.auth-card h2 {
  font-size: clamp(2rem, 2.8vw, 2.6rem);
}

.auth-copy {
  max-width: 32rem;
}

.login-error {
  border: 1px solid rgba(220, 38, 38, 0.14);
}

.password-toggle {
  width: 34px;
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.form-options {
  gap: 12px;
}

.login-btn {
  padding: 14px 18px;
}

.login-footer {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid var(--color-border-soft);
}

.btn-spinner {
  width: 16px;
  height: 16px;
}

@media (max-width: 1200px) {
  .dashboard-hero {
    grid-template-columns: 1fr;
  }

  .page-hero {
    grid-template-columns: 1fr;
  }

  .hero-panel {
    min-height: 180px;
  }

  .topbar-search {
    min-width: 280px;
  }
}

@media (max-width: 1024px) {
  .app-container {
    display: block;
  }

  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: 300px;
    transform: translateX(-102%);
    transition: transform var(--t-base), box-shadow var(--t-base);
    z-index: 120;
  }

  .sidebar.open {
    transform: translateX(0);
    box-shadow: 24px 0 50px rgba(0, 0, 0, 0.32);
  }

  .main-content {
    min-height: 100vh;
  }

  .page-content {
    padding: 24px;
  }

  .grid-4-cols,
  .grid-3-cols,
  .grid-2x2,
  .dashboard-insights-grid {
    grid-template-columns: 1fr;
  }

  .sidebar-nav,
  .sidebar-footer,
  .sidebar-header {
    padding-left: 18px;
    padding-right: 18px;
  }

  .auth-shell {
    flex-direction: column;
  }

  .auth-brand-panel,
