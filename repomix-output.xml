  Serial.printf("  BH1750  (Luminosidad)   : %s\n", bh1750Activo ? "✓ ACTIVO" : "✗ NO DETECTADO");
  Serial.printf("  HX711   (Peso)          : %s\n", hx711Activo ? "✓ ACTIVO" : "✗ NO DETECTADO");
