  box-shadow: var(--shadow-glow);
  transform: translateY(-1px);
}
.form-control::placeholder { color: var(--color-text-tertiary); }

.floating-field .field-shell {
  position: relative;
  display: flex;
  align-items: center;
}
.floating-field .form-control {
  padding-left: 48px;
  padding-right: 48px;
}
.floating-field .form-label {
  position: absolute;
  left: 16px;
  top: 16px;
  margin: 0;
  padding: 0 6px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--color-surface) 84%, transparent);
  color: var(--color-text-tertiary);
  pointer-events: none;
  transform-origin: left top;
  transition: transform var(--t-fast), color var(--t-fast), top var(--t-fast), background var(--t-fast);
}
.floating-field .form-control:focus + .form-label,
.floating-field .form-control:not(:placeholder-shown) + .form-label {
  top: -9px;
  color: var(--color-brand-dark);
  transform: scale(0.86);
}
.floating-field .field-shell:focus-within .form-label {
  color: var(--color-brand-dark);
}
.password-input-wrapper {
