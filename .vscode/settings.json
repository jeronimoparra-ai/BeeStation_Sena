{
  // Git integration
  "git.enabled": true,
  "git.autofetch": true,
  "git.autorefresh": true,
  "git.autofetchPeriod": 60,
  "git.suggestSmartCommit": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.path": "",
  "git.inputValidationLength": 72,
  "git.inputValidationLengthWarning": 50,
  "git.inputValidationSubjectLength": 50,

  // Files
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.encoding": "utf8",

  // Search excludes
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/.cache": true,
    "**/htdocs/.archive_old": true,
    "**/htdocs/uploads/cache": true
  },
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,

  // File watcher excludes (reduce CPU)
  "files.watcherExclude": {
    "**/htdocs/**": false,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/htdocs/uploads/**": true,
    "**/htdocs/logs/**": true
  },

  // PHP
  "php.executablePath": "php",
  "php.validate.executablePath": "php",
  "php.suggest.basic": false,
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-great-icons",
    "editor.tabSize": 4,
    "files.associations": {
      "*.php": "php"
    }
  },

  // Arduino / PlatformIO
  "arduino.path": "",
  "platformio-ide.customPATH": "",
  "[cpp]": {
    "editor.tabSize": 2
  },

  // SQL
  "sql.format.whitespace.tabAsSpaces": true,
  "[sql]": {
    "editor.tabSize": 4
  },

  // Editor defaults
  "editor.fontFamily": "Consolas, 'Courier New', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 21,
  "editor.minimap.enabled": true,
  "breadcrumbs.enabled": true,
  "workbench.editor.enablePreview": false,
  "workbench.editor.wrapTabs": true,
  "workbench.colorTheme": "Default Dark+",
  "workbench.iconTheme": "vs-seti",
  "window.zoomLevel": 0,

  // Breadcrumbs / minimap
  "editor.renderLineHighlight": "all",
  "editor.cursorBlinking": "smooth",
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on"
}
