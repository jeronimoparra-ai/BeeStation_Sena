{
  // ── Git ──────────────────────────────────────────────────────
  "git.enabled": true,
  "git.autofetch": true,
  "git.autorefresh": true,
  "git.autofetchPeriod": 60,
  // Smart commit desactivado a propósito: este repositorio guarda
  // credenciales y datos de sensores; cada commit debe revisarse.
  "git.suggestSmartCommit": false,
  "git.enableSmartCommit": false,
  "git.confirmSync": false,
  "git.inputValidationLength": 72,
  "git.inputValidationLengthWarning": 50,
  "git.inputValidationSubjectLength": 50,

  // ── Archivos ─────────────────────────────────────────────────
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.encoding": "utf8",
  "files.associations": {
    "*.php": "php",
    "*.ino": "cpp"
  },

  // ── Ruido del proyecto ───────────────────────────────────────
  "files.exclude": {
    "**/beestation_node/build": true,
    "**/tests/host/build": true,
    "**/database/dumps": true,
    "**/*.bak": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/.git": true,
    "**/beestation_node/build": true,
    "**/tests/host/build": true,
    "**/database/dumps": true
  },
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/beestation_node/build/**": true,
    "**/tests/host/build/**": true,
    "**/database/dumps/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true
  },

  // ── PHP ──────────────────────────────────────────────────────
  "php.validate.executablePath": "C:\\xampp\\php\\php.exe",
  "php.suggest.basic": false,
  "[php]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    // No hay formateador PHP instalado: evitar que VS Code invente uno.
    "editor.formatOnSave": false
  },

  // ── C/C++ (firmware ESP32) ───────────────────────────────────
  "[cpp]": {
    "editor.tabSize": 2
  },

  // ── SQL ──────────────────────────────────────────────────────
  "sql.format.whitespace.tabAsSpaces": true,
  "[sql]": {
    "editor.tabSize": 4
  },

  // ── Terminal ─────────────────────────────────────────────────
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.defaultProfile.windows": "PowerShell",

  // ── Editor ───────────────────────────────────────────────────
  "editor.fontFamily": "Consolas, 'Courier New', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 21,
  "editor.minimap.enabled": true,
  "breadcrumbs.enabled": true,
  "workbench.editor.enablePreview": false,
  "workbench.editor.wrapTabs": true,
  "workbench.colorTheme": "Dark+",
  "workbench.iconTheme": "material-icon-theme",
  "window.zoomLevel": 0,

  // ── Breadcrumbs / minimapa ───────────────────────────────────
  "editor.renderLineHighlight": "all",
  "editor.cursorBlinking": "smooth",
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on"
}
